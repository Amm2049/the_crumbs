# ==============================================================================
# The Crumbs — Environment Configuration Template
# Copy this file to .env.local and fill in the values before starting the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Neon / Supabase / Local)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Generate with: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-auth-secret-32-chars-min"

# Google OAuth Credentials (console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. Media & Image Uploads (Cloudinary)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# ------------------------------------------------------------------------------
# 4. Real-time Events & WebSockets (Pusher Channels)
# ------------------------------------------------------------------------------
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ------------------------------------------------------------------------------
# 5. Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
